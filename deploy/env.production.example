# 生产环境变量模板。
#
# 用法:
#   cp deploy/env.production.example .env.production
#   编辑 .env.production 填真值
#   chmod 600 .env.production       ← 只让 owner 读
#
# 警告:.env.production 已在 .gitignore 里,绝不要 commit。

# ─── Postgres(compose 起本地 PG)───
# 强密码,只用于容器内,但仍应足够复杂(避免容器逃逸后的横向移动)
POSTGRES_PASSWORD=change_me_to_a_strong_random_string

# DATABASE_URL 在 compose 里会被自动覆盖成 postgres:5432,这里不用改

# ─── LLM Keys(必填一个)───
DEEPSEEK_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx

# ─── Web search ───
TAVILY_KEY=tvly-xxx

# ─── 日志 ───
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── 业务配置 ───
LANGUAGE=zh-CN
NOTES_DIR=notes

# ─── 飞书(暂未启用,占位)───
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
