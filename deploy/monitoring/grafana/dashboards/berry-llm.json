  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "LLM QPS by model",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(berry_llm_calls_total[5m])) by (model_logical)",
          "legendFormat": "{{model_logical}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "LLM failure rate by model",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(berry_llm_calls_total{status=\"failed\"}[5m])) by (model_logical) / clamp_min(sum(rate(berry_llm_calls_total[5m])) by (model_logical), 0.0001)",
          "legendFormat": "{{model_logical}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "LLM latency p50 / p95 / p99 by model",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(berry_llm_call_duration_seconds_bucket[5m])) by (model_logical, le))",
          "legendFormat": "p50 · {{model_logical}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(berry_llm_call_duration_seconds_bucket[5m])) by (model_logical, le))",
          "legendFormat": "p95 · {{model_logical}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(berry_llm_call_duration_seconds_bucket[5m])) by (model_logical, le))",
          "legendFormat": "p99 · {{model_logical}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "timeseries",
      "title": "Token rate by model and kind",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum(rate(berry_llm_tokens_total[5m])) by (model_logical, kind)",
          "legendFormat": "{{model_logical}} · {{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}}
    },
    {
      "type": "stat",
      "title": "Tokens (last 1h, total)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(increase(berry_llm_tokens_total[1h])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}},
      "options": {"orientation": "horizontal", "textMode": "auto"}
    }
  ],
