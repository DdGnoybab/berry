# Web frontend image — Vite build → nginx 静态服务 + /v1 反代到 berry.
#
# 构建:  docker build -f deploy/Dockerfile.web -t berry-web:latest .
# 运行:  通过 docker-compose.yml

# ───── Stage 1: build ─────
FROM node:22-alpine AS build
WORKDIR /web

# 利用 layer cache:依赖锁文件先拷
COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
RUN npm run build


# ───── Stage 2: nginx ─────
FROM nginx:1.27-alpine

# 拷反代配置
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# 拷构建产物
COPY --from=build /web/dist /usr/share/nginx/html

EXPOSE 80
