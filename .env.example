# ─── 数据库 ───
# alembic 用同步 driver(psycopg / 默认 psycopg2-style URL)
# 应用代码用 asyncpg(URL 加 +asyncpg)
# 我们统一在 config.py 里转换,这里写「无 driver 前缀」的形式即可
# ─── 数据库 ───
# 格式:postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/berry

# ─── LLM API keys ───
# config/models.yaml 里 ${DEEPSEEK_KEY} 等会被替换成下面的真值
DEEPSEEK_KEY=sk-xxx
# 默认 main alias 走 deepseek-anthropic 不需要这个。
# 想切到真 Anthropic 端点验证 prompt cache 时,把 yaml 的 main 改成 anthropic-claude
# 并把下面这行的值换成 sk-ant-... 形式的真 Anthropic key。
ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_KEY=sk-xxx              # 后续

# ─── Web search(Round 3)───
# config/search.yaml 里 ${TAVILY_KEY} 会被替换成下面的真值
# 申请:https://app.tavily.com/home  免费 1k 次/月
TAVILY_KEY=tvly-xxx

# ─── 日志 ───
LOG_LEVEL=INFO

# 文件落盘 — /admin/logs 面板的数据来源
# stdout 永远开(Docker logs 用),文件 sink 是额外加的
LOG_TO_FILE=true
# 容器里 /app/data/logs 已经挂在 berry_data 卷上
LOG_DIR=/app/data/logs
# 每天 UTC 0 点切片,旧文件 gzip,超过此天数自动删
LOG_RETENTION_DAYS=3

# ─── 开发模式 ───
# 设为 1 开启 uvicorn 热更新(改代码自动重启)
BERRY_DEV=1

# ─── Learning assistant ───
# Berry 跟用户对话的默认语言(渲染进 system prompt 的 # Runtime config 段)
LANGUAGE=zh-CN
# 笔记目录(相对 cwd),system prompt 段 7 扫这里的 .md
NOTES_DIR=notes

# ─── Feishu（Stage 4 才真用，占位先放这）──────────────
# 在 https://open.feishu.cn 创建应用拿到这些值
# 警告：绝不把真凭证 commit 进 git
FEISHU_APP_ID=cli_placeholder
FEISHU_APP_SECRET=feishu_app_secret_placeholder
FEISHU_VERIFICATION_TOKEN=feishu_verification_token_placeholder
FEISHU_ENCRYPT_KEY=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_BOT_NAME=berry
# DM 准入策略,对齐 openclaw `dmPolicy`:
#   open       — 任何 sender 的 DM 都放行(默认,跟 openclaw 一致)
#   allowlist  — 只放行 FEISHU_ALLOWED_OPEN_IDS 里的 open_id
FEISHU_DM_POLICY=open
# 仅当 FEISHU_DM_POLICY=allowlist 时生效;open 模式可留空。
# 写法:逗号分隔多个 open_id,例:ou_xxx,ou_yyy
FEISHU_ALLOWED_OPEN_IDS=
# Bot 自身 open_id,群聊 @ 检测需要;空 → 群聊整体禁用(DM 不受影响)。
# 启动前用 lark 控制台 / API 查一次粘这里。
FEISHU_BOT_OPEN_ID=
# 群聊白名单 chat_id(逗号分隔,例:oc_xxx,oc_yyy);空 → 群聊禁用。
# 群里任何人 @ berry 都能触发,但群本身必须在这里登记。
FEISHU_GROUP_ALLOW_FROM=
