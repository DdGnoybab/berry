# ─── 数据库 ───
# alembic 用同步 driver(psycopg / 默认 psycopg2-style URL)
# 应用代码用 asyncpg(URL 加 +asyncpg)
# 我们统一在 config.py 里转换,这里写「无 driver 前缀」的形式即可
# ─── 数据库 ───
# 格式:postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/berry

# ─── LLM API keys ───
# config/models.yaml 里 ${DEEPSEEK_KEY} 等会被替换成下面的真值
DEEPSEEK_KEY=sk-xxx
# ANTHROPIC_KEY=sk-ant-xxx       # Batch 2 用
# OPENAI_KEY=sk-xxx              # 后续

# ─── Web search(Round 3)───
# config/search.yaml 里 ${TAVILY_KEY} 会被替换成下面的真值
# 申请:https://app.tavily.com/home  免费 1k 次/月
TAVILY_KEY=tvly-xxx

# ─── 日志 ───
LOG_LEVEL=INFO

# ─── Feishu（Stage 4 才真用，占位先放这）──────────────
# 在 https://open.feishu.cn 创建应用拿到这些值
# 警告：绝不把真凭证 commit 进 git
FEISHU_APP_ID=cli_placeholder
FEISHU_APP_SECRET=feishu_app_secret_placeholder
FEISHU_VERIFICATION_TOKEN=feishu_verification_token_placeholder
FEISHU_ENCRYPT_KEY=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_BOT_NAME=berry
# 单用户 MVP 强烈建议设白名单（逗号分隔多个 open_id），Stage 4 强制
FEISHU_ALLOWED_OPEN_IDS=
