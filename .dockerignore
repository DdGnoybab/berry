# 让 docker build 的 context 尽量小

.git
.gitignore
.venv
venv
env

# 真凭证绝不进镜像
.env
.env.local
.env.production

__pycache__
*.pyc
*.pyo
*.egg-info
build
dist

# 前端 build 走另一个 Dockerfile,不影响后端镜像
web/node_modules
web/dist

# 本地数据 / 日志
data
logs
*.log

# IDE
.idea
.vscode
.DS_Store

# 文档 / 测试不进生产镜像
# 但 user-guide.md / admin/logs-guide.md 例外:运行时 /v1/docs/* 服务给前端
# 抽屉用,Dockerfile COPY 它们,所以必须放进 build context。
docs
!docs/user-guide.md
!docs/admin
!docs/admin/logs-guide.md
notes
quizzes
test
tests
reference
SESSION_LOG.md
PROGRESS.md

# 已存在的 dockerfile 副产物
deploy/*.local
